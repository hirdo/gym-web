rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Current: permissive rules for Keycloak-based auth (no Firebase Auth tokens).
    // Client-side enforcement via AuthService.isAdmin() guards write operations.
    match /{document=**} {
      allow read, write: if true;
    }

    // ── Future rules for Firebase Auth integration ──────────────────────
    // When Firebase custom tokens are minted from Keycloak JWTs,
    // replace the permissive rule above with the following:
    //
    // function isAdmin() {
    //   return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    // }
    //
    // match /users/{userId} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }
    //
    // match /workouts/{workoutId} {
    //   allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    //   allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    // }
    //
    // match /workout_sessions/{sessionId} {
    //   allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    //   allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    // }
    //
    // match /exercises/{exerciseId} {
    //   allow read: if request.auth != null;
    //   allow write: if request.auth != null && isAdmin();
    // }
    //
    // match /programs/{programId} {
    //   allow read: if request.auth != null;
    //   allow write: if request.auth != null && isAdmin();
    // }
  }
}
